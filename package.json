{
    "name": "fluentsupport",
    "version": "1.0.0",
    "scripts": {
        "dev": "node vite-mode.js dev && vite",
        "build": "node vite-mode.js prod && vite build && vite build --config vite.config.portal.mjs && npm run build:block",
        "build:admin": "node vite-mode.js prod && vite build",
        "build:portal": "vite build --config vite.config.portal.mjs",
        "prod": "node vite-mode.js prod && vite build && vite build --config vite.config.portal.mjs && npm run build:block",
        "watch": "vite build --watch",
        "mode:dev": "node vite-mode.js dev",
        "mode:prod": "node vite-mode.js prod",
        "build:block": "wp-scripts build --webpack-src-dir=resources/block-editor/blocks/customer-portal --output-path=assets/block-editor/js --config webpack.config.block.js && mv assets/block-editor/js/index.js assets/block-editor/js/fs_block.js && mv assets/block-editor/js/index.js.LICENSE.txt assets/block-editor/js/fs_block.js.LICENSE.txt 2>/dev/null; mv -f assets/block-editor/css/index.css assets/block-editor/css/fs_block.css 2>/dev/null; mv -f assets/block-editor/js/index-rtl.css assets/block-editor/css/fs_block-rtl.css 2>/dev/null; rm -f assets/block-editor/js/index.asset.php",
        "rtl": "find assets -type f -name '*.css' ! -name '*-rtl.css' ! -name '*.rtl.css' -exec sh -c 'rtlcss \"$1\" \"${1%.css}-rtl.css\"' _ {} \\;"
    },
    "author": "wpmn",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/techjewel/wpmn-framework/issues"
    },
    "homepage": "https://github.com/techjewel/wpmn-framework#readme",
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@wordpress/api-fetch": "^7.22.0",
        "@wordpress/block-editor": "^14.3.16",
        "@wordpress/blocks": "^13.8.6",
        "@wordpress/components": "^28.8.12",
        "@wordpress/element": "^6.8.1",
        "@wordpress/hooks": "^4.8.2",
        "@wordpress/i18n": "^5.8.2",
        "@wordpress/server-side-render": "^5.8.12",
        "apexcharts": "^5.10.0",
        "chart.js": "^4.4.8",
        "dayjs": "^1.11.13",
        "dompurify": "^3.4.13",
        "echarts": "^5.5.1",
        "element-plus": "^2.9.7",
        "firebase": "^11.6.0",
        "highlight.js": "^11.11.1",
        "lodash": "^4.17.21",
        "marked": "^16.1.2",
        "mitt": "^3.0.1",
        "pinia": "^3.0.4",
        "rtlcss": "^4.3.0",
        "vue-router": "^4.5.0",
        "vue3-apexcharts": "^1.8.0",
        "vue3-chart-v2": "^0.8.3",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "@vue/compiler-sfc": "^3.5.13",
        "@wordpress/scripts": "30.0.6",
        "postcss": "^8.5.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sass": "^1.86.3",
        "style-loader": "^4.0.0",
        "terser": "^5.37.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^31.0.0",
        "vite": "^5.0.0",
        "vite-plugin-static-copy": "^1.0.6",
        "vue": "^3.5.13"
    }
}
