# Optional local overrides. Copy to tests/lab/.env.
# Values are lab-only defaults, never production credentials.

FS_LAB_HTTP_PORT=8901

FS_LAB_DB_NAME=fluent_support_test
FS_LAB_DB_USER=fs_lab
FS_LAB_DB_PASSWORD=fs_lab_only
FS_LAB_DB_ROOT_PASSWORD=fs_root_lab_only

FS_LAB_ADMIN_USER=fsadmin
FS_LAB_ADMIN_PASSWORD=fluent-support-lab-only
FS_LAB_ADMIN_EMAIL=fsadmin@example.test

# Image overrides. Defaults stay multi-architecture.
# FS_LAB_DB_IMAGE=mariadb:11.4
# FS_LAB_WORDPRESS_IMAGE=wordpress:php8.2-apache
# FS_LAB_WPCLI_IMAGE=wordpress:cli-php8.2
